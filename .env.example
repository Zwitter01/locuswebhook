# ==========================================
# ⚙️ CONFIGURATION FOR TELEGRAM & EMAIL
# ==========================================

# Port the Express server listens on
PORT=3000

# ------------------------------------------
# 📱 TELEGRAM NOTIFICATION SETTINGS
# ------------------------------------------
# 1. Create a bot using @BotFather on Telegram (https://t.me/BotFather)
# 2. Paste your Bot API Token below:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Open your bot and send /start, then run: npm run get-chat-id
#    Or use @userinfobot to get your numeric ID:
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------
# 📧 EMAIL NOTIFICATION SETTINGS (Gmail)
# ------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
# Gmail 16-character App Password (https://myaccount.google.com/apppasswords)
EMAIL_PASS=your_16_char_app_password
EMAIL_TO=recipient_email@gmail.com
